/* SPA fallback : toute route inconnue est servie par index.html (200).
   Les fichiers réels (assets, sw.js, manifest.webmanifest) sont servis
   en priorité, la règle ne s'applique qu'en dernier ressort. */
/*    /index.html   200

# Service Worker : jamais de cache court, toujours revalidé
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Le manifest peut être mis en cache long
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Les assets hachés par Vite sont immuables
/assets/*
  Cache-Control: public, max-age=31536000, immutable
